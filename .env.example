# Optional. Interactive `alchemy login` stores credentials in
# ~/.alchemy/profiles.json. CI can set these instead of OAuth.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional first-level project hostname suffix, e.g. example.com
# Absence keeps workers.dev path URLs only. Do not include a scheme or wildcard.
# QUICKSHARE_CONTENT_DOMAIN=

# Operator-owned preview hostname used only for `alchemy plan --stage preview`.
# QUICKSHARE_PREVIEW_CONTENT_DOMAIN=
