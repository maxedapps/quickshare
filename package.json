{
  "name": "quickshare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local-only-invalid-token QUICKSHARE_LOCAL_DEV_STATE=true alchemy dev --stage local",
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260811.1",
    "@effect/platform-node": "4.0.0-rc.110",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.110",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.110",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0"
}
